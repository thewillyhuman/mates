{
  "name": "mates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous ticket-to-merge-request agents for Jira + GitLab/GitHub, built on Claude Code, deployed on Kubernetes.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
