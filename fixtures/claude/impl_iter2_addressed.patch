diff --git a/src/webhook/retry.py b/src/webhook/retry.py
index baf322f..9629ae1 100644
--- a/src/webhook/retry.py
+++ b/src/webhook/retry.py
@@ -1,19 +1,26 @@
 """Retry policy for webhook delivery."""
 
+MAX_WINDOW_SECONDS = 600.0
+
 
 class RetryPolicy:
-    """Exponential backoff starting at ``base_seconds``."""
+    """Exponential backoff, capped so all attempts fit in ten minutes."""
 
     def __init__(self, base_seconds: float = 1.0, max_attempts: int = 5) -> None:
         self.base_seconds = base_seconds
         self.max_attempts = max_attempts
 
     def delay(self, attempt: int) -> float:
-        """Delay before ``attempt`` (1-based)."""
+        """Delay before ``attempt`` (1-based), never beyond the window."""
         if attempt < 1:
             raise ValueError("attempt must be >= 1")
-        return self.base_seconds * (2 ** (attempt - 1))
+        return min(self.base_seconds * (2 ** (attempt - 1)), MAX_WINDOW_SECONDS)
 
     def should_retry(self, attempt: int) -> bool:
         """Retry while ``attempt`` is below the configured ceiling."""
         return attempt < self.max_attempts
+
+
+def dead_letter(delivery: dict, attempts: int) -> dict:
+    """Marks an exhausted delivery for the dead-letter queue."""
+    return {**delivery, "status": "dead_letter", "attempts": attempts}
