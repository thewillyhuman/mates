{
  "name": "mates-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Mates web UI (React + Vite). Built into mates-api/public and served by the API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "generate:api": "pnpm --filter mates-api openapi && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@mates/core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jose": "^6.2.12",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
