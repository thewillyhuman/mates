{
  "name": "@mates/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure domain code shared by mates-api, mates-runner and mates-ui: stages, events, projection, validation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
